# Neon (recommended) or any PostgreSQL
# Get this from: https://console.neon.tech → your project → Connection string
# Use the "Pooled" connection string for serverless / Vercel
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional: non-pooled URL for migrations (Neon shows both)
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Supabase (optional – auth later)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
