generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Multi-tenant foundation (rural operators often have multiple sites) ---

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("sprout") // sprout | growth | enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations Location[]
  users     User[]
}

model Location {
  id        String   @id @default(uuid())
  tenantId  String?
  name      String
  address   String?
  city      String?
  state     String?
  timezone  String   @default("America/Chicago")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  shifts Shift[]
  users  User[]
}

model User {
  id         String   @id @default(uuid())
  tenantId   String?
  locationId String?
  email      String   @unique
  name       String?
  phone      String?
  role       String   @default("employee") // employee | manager | admin
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant       Tenant?            @relation(fields: [tenantId], references: [id])
  location     Location?          @relation(fields: [locationId], references: [id])
  shifts       Shift[]
  punches      Punch[]
  coverageReqs CoverageRequest[]
  ptoRequests  PtoRequest[]
  ptoBalances  PtoBalance[]
}

model Shift {
  id         String   @id @default(uuid())
  userId     String?
  locationId String
  role       String
  startTime  DateTime
  endTime    DateTime
  notes      String?
  status     String   @default("scheduled") // scheduled | open | completed | cancelled
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user        User?            @relation(fields: [userId], references: [id])
  location    Location         @relation(fields: [locationId], references: [id])
  coverageReq CoverageRequest?
}

model CoverageRequest {
  id        String   @id @default(uuid())
  shiftId   String   @unique
  userId    String?
  status    String   @default("pending") // pending | accepted | declined | filled
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shift Shift  @relation(fields: [shiftId], references: [id])
  user  User?  @relation(fields: [userId], references: [id])
}

model Punch {
  id        String   @id @default(uuid())
  userId    String
  type      String   // clock_in | clock_out | break_start | break_end
  timestamp DateTime @default(now())
  approved  Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PtoRequest {
  id        String   @id @default(uuid())
  userId    String
  startDate DateTime
  endDate   DateTime
  type      String   // vacation | sick | personal | unpaid
  status    String   @default("pending") // pending | approved | denied | cancelled
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model PtoBalance {
  id        String   @id @default(uuid())
  userId    String
  type      String   // vacation | sick | personal
  hours     Float    @default(0)
  year      Int
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type, year])
}
